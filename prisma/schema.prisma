// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LevelType {
  BLIND
  BREAK
}

/// Vai trò của user. TRIAL / STANDARD đồng thời là gói sử dụng (xem PlanLimit).
enum UserRole {
  SUPER_ADMIN
  TRIAL
  STANDARD
}

enum EntryLogAction {
  ADD
  REMOVE
  REBUY
  BULK_UPDATE
}
model User {
  id Int @id @default(autoincrement())
  email String @unique
  // Định danh dạng URL, duy nhất toàn hệ thống (a-z, 0-9, '-', 3–30 ký tự)
  slug String @unique
  // Vai trò / gói. Đăng ký mới = TRIAL. Chỉ có đúng 1 SUPER_ADMIN (gán bằng script admin:promote)
  role UserRole @default(TRIAL)
  hashedPassword String
  firstName String?
  lastName String?
  displayName String?
  avatar String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours Tour[]
  defaultLevels DefaultLevel[]
  players Player[]
  tourEntryLogs TourEntryLog[]

  @@map("users")
}
model Tour {
  id Int @id @default(autoincrement())
  title String
  desc      String?
  startingStack Int?
  regEnd    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user User @relation(fields: [userId], references: [id])

  levels TourLevel[]
  control TourControl?
  entryLogs TourEntryLog[]

  @@map("tours")
}

model TourLevel {
  id Int @id @default(autoincrement())

  name     String?
  type     LevelType
  idx      Int
  duration Int

  smallBlind Int?
  bigBlind   Int?
  ante       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId Int
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, idx])
  @@map("tour_levels")
}

model TourControl {
  id Int @id @default(autoincrement())

  currentLevel   Int       @default(1)
  isPaused       Boolean   @default(true)
  isRunning      Boolean   @default(false)
  pausedAtSecond Int       @default(0)
  levelStartedAt DateTime?

  // Mảng các entry dạng { id: string (uuid); playerId?; name; avatar?; isEliminated; reBuyCount; addOn: number[] }
  entries Json @default("[]")

  // Chuỗi giải thưởng GTD dạng '10/5/3/3/1/..'
  gtd String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId Int  @unique
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("tour_controls")
}

model DefaultLevel {
  id Int @id @default(autoincrement())

  name     String?
  type     LevelType
  idx      Int
  duration Int

  smallBlind Int?
  bigBlind   Int?
  ante       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idx])
  @@map("default_levels")
}

model Player {
  id Int @id @default(autoincrement())

  name   String
  avatar String?
  // Điểm của người chơi (số thực, không âm)
  point  Float   @default(0)
  // Số điện thoại (đã chuẩn hoá: chỉ chữ số, có thể có '+' ở đầu); không trùng trong cùng user
  phone  String?
  // Tên đã bỏ dấu + chữ thường để tìm kiếm (server tự cập nhật, không trả cho client)
  searchName String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@map("players")
}

/// Log thao tác trên entries của tour (thêm/xoá/rebuy/cập nhật hàng loạt) – dùng cho undo.
model TourEntryLog {
  id Int @id @default(autoincrement())

  action    EntryLogAction
  /// Id (uuid) của entry bị tác động; null với BULK_UPDATE
  entryId   String?
  /// Tên entry tại thời điểm thao tác (để hiển thị log)
  entryName String?
  /// Toàn bộ entries TRƯỚC thao tác (undo sẽ khôi phục giá trị này)
  before    Json
  /// Toàn bộ entries SAU thao tác (dùng để phát hiện xung đột khi undo)
  after     Json
  /// Khác null = thao tác đã được undo
  undoneAt  DateTime?

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tourId Int
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, id])
  @@map("tour_entry_logs")
}

/// Giới hạn tính năng theo gói (TRIAL / STANDARD) – super admin chỉnh qua API.
/// Giá trị số = null nghĩa là không giới hạn.
model PlanLimit {
  id Int @id @default(autoincrement())

  plan             UserRole @unique
  /// Số player tối đa trong danh sách player
  maxPlayers       Int?
  /// Số tour tối đa được tạo
  maxTours         Int?
  /// Số tour được chạy cùng lúc tối đa
  maxRunningTours  Int?
  /// Được xuất Excel danh sách player
  canExportPlayers Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plan_limits")
}
