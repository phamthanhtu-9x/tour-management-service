// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LevelType {
  BLIND
  BREAK
}
model User {
  id Int @id @default(autoincrement())
  email String @unique
  hashedPassword String
  firstName String?
  lastName String?
  displayName String?
  avatar String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours Tour[]
  defaultLevels DefaultLevel[]
  players Player[]

  @@map("users")
}
model Tour {
  id Int @id @default(autoincrement())
  title String
  desc      String?
  startingStack Int?
  regEnd    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user User @relation(fields: [userId], references: [id])

  levels TourLevel[]
  control TourControl?

  @@map("tours")
}

model TourLevel {
  id Int @id @default(autoincrement())

  name     String?
  type     LevelType
  idx      Int
  duration Int

  smallBlind Int?
  bigBlind   Int?
  ante       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId Int
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, idx])
  @@map("tour_levels")
}

model TourControl {
  id Int @id @default(autoincrement())

  currentLevel   Int       @default(1)
  isPaused       Boolean   @default(true)
  isRunning      Boolean   @default(false)
  pausedAtSecond Int       @default(0)
  levelStartedAt DateTime?

  // Mảng các entry dạng { name: string; avatar?: string; isEliminated: boolean }
  entries Json @default("[]")

  // Chuỗi giải thưởng GTD dạng '10/5/3/3/1/..'
  gtd String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId Int  @unique
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("tour_controls")
}

model DefaultLevel {
  id Int @id @default(autoincrement())

  name     String?
  type     LevelType
  idx      Int
  duration Int

  smallBlind Int?
  bigBlind   Int?
  ante       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idx])
  @@map("default_levels")
}

model Player {
  id Int @id @default(autoincrement())

  name   String
  avatar String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("players")
}
